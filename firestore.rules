rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /enquiries/{doc} {
      allow read, write: if request.auth != null;
    }
    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }
    match /marketing/{doc} {
      allow read, write: if request.auth != null;
    }

    // Guests (not logged in) can submit; only staff can read.
    match /precheckin/{doc} {
      allow read: if request.auth != null;
      allow create: if true;
    }
    match /feedback/{doc} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // Contracts: staff create/read/write. Client (anonymous) may read
    // their own by link and update only the client signature fields.
    match /quotes/{doc} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acceptedBy','acceptedDate','acceptedAt','status']));
    }
    match /contracts/{doc} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clientSig','clientDate','clientSignedAt','status']));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
