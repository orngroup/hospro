rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'ajay.kawa@brandonhall.portal',
          'raj.kumar@brandonhall.portal',
          'alia.taub@brandonhall.portal',
          'nicola.cartwright@brandonhall.portal',
          'natalie.freeman@brandonhall.portal',
          'patrik.vlach@brandonhall.portal',
          'veronica.webb@brandonhall.portal',
          'laith.hardy@brandonhall.portal',
          'staff1@brandonhall.portal',
          'staff2@brandonhall.portal',
          'staff3@brandonhall.portal',
          'staff4@brandonhall.portal',
          'staff5@brandonhall.portal',
          'staff6@brandonhall.portal',
          'staff7@brandonhall.portal',
          'staff8@brandonhall.portal'
        ];
    }

    function isPayroll() {
      return isStaff() && request.auth.token.email in [
          'ajay.kawa@brandonhall.portal',
          'raj.kumar@brandonhall.portal',
          'alia.taub@brandonhall.portal',
          'veronica.webb@brandonhall.portal'
        ];
    }

    match /enquiries/{doc} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        || (request.auth != null && request.resource.data.status == 'new' && request.resource.data.size() <= 40);
      allow update: if isStaff()
        || (request.auth != null && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && resource.data.stage == 'Planner started');
    }
    match /meta/{doc}      { allow read, write: if isStaff(); }
    match /marketing/{doc} { allow read, write: if isStaff(); }
    match /newsletters/{doc} { allow read, write: if isStaff(); }

    match /access_log/{doc} {
      allow read: if isStaff();
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.size() <= 20;
      allow update, delete: if false;
    }

    match /precheckin/{doc} {
      allow read: if isStaff();
      allow create: if true;
    }
    match /feedback/{doc} {
      allow read: if isStaff();
      allow create: if true;
    }

    // Christmas competition entries from the website quiz
    // (www.brandonhallhotelandspa.com/christmas-competition/): anyone may enter,
    // only staff can see, edit or remove entries.
    match /competition/{doc} {
      allow read, update, delete: if isStaff();
      allow create: if request.resource.data.campaign == 'xmas2026'
        && request.resource.data.size() <= 20
        && request.resource.data.email is string && request.resource.data.email.size() < 200;
    }

    // Guest Wi-Fi welcome page (brandonhallhotelandspa.com/wifi): guests can add
    // their own sign-up; only staff can read, edit or delete.
    match /wifi_signups/{doc} {
      allow read, update, delete: if isStaff();
      allow create: if request.resource.data.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200;
    }

    match /quotes/{doc} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acceptedBy','acceptedDate','acceptedAt','status','acceptedOption']));
    }
    match /contracts/{doc} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clientSig','clientDate','clientSignedAt','status']));
    }

    match /beverage/{doc} {
      allow read: if true;
      allow write: if true;
      match /log/{entry} { allow read, write: if true; }
    }

    match /hosfix_jobs/{jobId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /hospro_public/{docId} {
      allow read: if docId in ['rota', 'summary'];
      allow create, update: if docId == 'rota' || (docId == 'summary' && isStaff());
      allow delete: if false;
    }

    match /hr_private/{docId} {
      allow read, write: if isPayroll() && docId == 'vault';
    }

    match /fb_tracker/{docId} {
      allow read, write: if isStaff();
    }

    match /fb_submissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['date','by','sales','invoices','notes','submittedAt','status'])
        && request.resource.data.status == 'new'
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
      allow read, update, delete: if isStaff();
    }

    match /mkt_requests/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.ref is string
        && request.resource.data.concept is string;
      allow read, update, delete: if isStaff();
    }

    // HosMarketing — Venue & Event Action Plan (marketing-plan.html): shareable
    // for review/approval, so anyone with the link can read & update; only
    // signed-in staff can delete a line.
    match /mkt_plan/{id} { allow read, create, update: if true; allow delete: if isStaff(); }

    // Reception daily-tasks self-assessment (hosrole.html): anyone on the
    // reception console can submit/read; only signed-in staff can delete.
    match /hosdesk_roles/{id} { allow read, create, update: if true; allow delete: if isStaff(); }

    match /hoshub/{doc}       { allow read, write: if isStaff(); }
    match /hoshub_docs/{doc}  { allow read, write: if isStaff(); }

    match /hosrev_settings/{doc}  { allow read, write: if isStaff(); }
    match /hosrev_books/{doc}     { allow read, write: if isStaff(); }
    match /hosrev_comp/{doc}      { allow read, write: if isStaff(); }
    match /hosrev_events/{doc}    { allow read, write: if isStaff(); }
    match /hosrev_decisions/{doc} { allow read, write: if isStaff(); }

    match /clock_roster/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /clock_punches/{doc} {
      allow read: if isStaff();
      allow create: if request.resource.data.size() <= 20
        && request.resource.data.keys().hasAll(['staffCode','date','ts','type']);
      allow update, delete: if isStaff();
    }
    // HosTIME reference photos — one per employee (their first clock-in). The clock page checks if
    // one exists and only stores it the first time, to save storage; managers can read/replace them.
    match /clock_faces/{code} {
      allow read: if true;
      allow create: if request.resource.data.size() <= 8
        && request.resource.data.keys().hasAll(['staffCode','photo']);
      allow update, delete: if isStaff();
    }

    match /hoshouse_rooms/{doc}  { allow read, write: if true; }
    match /hoshouse_config/{doc} { allow read, write: if true; }
    match /hoshouse_photos/{doc} { allow read, create, update: if true; allow delete: if isStaff(); }
    // Front Desk / Guest requests (hoshouse-request.html): anyone can log a request,
    // the staff board reads & updates; only signed-in staff can delete.
    match /hoshouse_requests/{doc} { allow read, create, update: if true; allow delete: if isStaff(); }
    // Reception console (hoshouse-request.html) — visitor log & delivery log:
    // anyone on the console can add/update; only signed-in staff can delete.
    match /hoshouse_visitors/{doc}   { allow read, create, update: if true; allow delete: if isStaff(); }
    match /hoshouse_deliveries/{doc} { allow read, create, update: if true; allow delete: if isStaff(); }
    // Reception shift handover notes (hoshouse-request.html): anyone on the
    // console can add/read; only signed-in staff can delete.
    match /hoshouse_handovers/{doc}  { allow read, create, update: if true; allow delete: if isStaff(); }
    // Staff directory phone numbers (hoshouse-request.html → Staff Directory):
    // anyone on the console can view/add/update a number; only signed-in staff can delete.
    match /hoshouse_staffdir/{doc}   { allow read, create, update: if true; allow delete: if isStaff(); }
    // HOD rota drafts (rota-hod.html → rota-approve.html): department heads submit a
    // draft week; approvers read all and publish to hospro_public/rota. Code-gated in-app.
    match /rota_drafts/{id}          { allow read, create, update, delete: if true; }
    // HosTV bedroom TV audit (hoshouse-request.html → HosTV): anyone on the console
    // can view and tick off a room; only signed-in staff can delete.
    match /hostv_rooms/{id}          { allow read, create, update: if true; allow delete: if isStaff(); }
    // HosSHIFT shift checklists (hoshouse-request.html → HosSHIFT): Early/Late/Night
    // checklists ticked per day; anyone on the console can add/update, staff can delete.
    match /hosnight_logs/{id}        { allow read, create, update: if true; allow delete: if isStaff(); }
    // HosNOTES reception notes board (hoshouse-request.html → HosNOTES): reception team
    // leave notes for everyone or a named person; anyone on the console can post/update/delete.
    match /hosnotes/{id}             { allow read, create, update, delete: if true; }
    // HosSHIFT daily ops (hoshouse-request.html → HosSHIFT): per-day shift start/finish times,
    // Music/Arrivals/Check-out timestamps and the running handover note that feed the home banners.
    match /hosshift_ops/{id}         { allow read, create, update: if true; allow delete: if isStaff(); }

    // ── HosFIRE ──
    function isFire() {
      return isStaff() || (request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['glenn.randell@brandonhall.portal', 'fire.kiosk@brandonhall.portal']);
    }
    function isFireAdmin() {
      return isFire() && request.auth.token.email in [
          'glenn.randell@brandonhall.portal',
          'ajay.kawa@brandonhall.portal',
          'raj.kumar@brandonhall.portal',
          'alia.taub@brandonhall.portal',
          'patrik.vlach@brandonhall.portal'
        ];
    }
    match /hosfire_records/{doc} {
      allow read: if isFire();
      allow create: if isFire()
        && request.resource.data.byEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /hosfire_actions/{doc}   { allow read, create, update: if isFire(); allow delete: if isFireAdmin(); }
    match /hosfire_registers/{doc} { allow read, create, update: if isFire(); allow delete: if isFireAdmin(); }
    match /hosfire_diary/{doc}     { allow read, create, update: if isFire(); allow delete: if isFireAdmin(); }
    match /hosfire_config/{doc}    { allow read: if isFire(); allow write: if isFireAdmin(); }
    match /hosfire_signatures/{doc} {
      allow read: if isFire();
      allow create: if isFire()
        && request.resource.data.byEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /hosfire_audit/{doc} {
      allow read: if isFire();
      allow create: if isFire() && request.resource.data.byEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // Online staff fire training (HosFIRE Training): add only, never edit or delete.
    match /hosfire_training/{doc} {
      allow read: if isFire();
      allow create: if isFire()
        && request.resource.data.byEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Landlord pack (/landlord): readable only by someone who knows the
    // password (the document id is derived from it); never listable.
    match /hosfire_share/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isFireAdmin();
    }

    // ── HosPRO Mobile (app.html) — app-level sign-in, open like HosHOUSE / HosFIX ──
    match /hospro_app/{doc}       { allow read, write: if true; }            // user directory & PIN changes
    match /hosfix_photos/{doc}    { allow read, create, update: if true; allow delete: if isStaff(); }
    match /hosfix_timelogs/{doc}  { allow read, create: if true; allow update, delete: if isStaff(); }
    match /hosrec_requests/{doc}  { allow read, create, update: if true; allow delete: if isStaff(); }
    match /hosrec_incidents/{doc} { allow read, create, update: if true; allow delete: if false; }
    match /hosrec_fire/{doc}      { allow read, create, update: if true; allow delete: if false; }
    match /fb_daily/{doc}         { allow read, create, update: if true; allow delete: if isStaff(); }
    match /fb_checks/{doc}        { allow read, create, update: if true; allow delete: if isStaff(); }
    match /fb_menus/{doc}         { allow read, write: if true; }

    // ── THE BARN HOTEL (thebarnhotel.hospro.co.uk) — own collections, prefixed barn_ ──
    // HosDesk + HosFix for The Barn: open like the Brandon Hall HosDesk/HosFix
    // collections above; jobs are archived, never deleted.
    match /barn_fix_jobs/{jobId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /barn_fix_photos/{doc}   { allow read, create, update: if true; allow delete: if false; }
    match /barn_fix_timelogs/{doc} { allow read, create, update: if true; allow delete: if false; }
    match /barn_deliveries/{doc}   { allow read, create, update: if true; allow delete: if false; }
    match /barn_visitors/{doc}     { allow read, create, update: if true; allow delete: if false; }
    match /barn_requests/{doc}     { allow read, create, update: if true; allow delete: if false; }
    match /barn_handovers/{doc}    { allow read, create, update: if true; allow delete: if false; }
    match /barn_config/{doc}       { allow read, write: if true; }
    // BarnHUB uploaded-document index (the files themselves are in Storage under barn_hub/)
    match /barn_hub_docs/{doc}     { allow read, create, update: if true; allow delete: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
